generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMLAR ───────────────────────────────────────────────
enum AccountType {
  student
  external
}

enum AuthProvider {
  local
  google
}

enum ListingType {
  secondhand
  roommate
  carpooling
  course
  job
  scholarship
  urgent
  note
}

enum ListingStatus {
  active
  sold
  closed
  expired
}

enum ItemCondition {
  new
  like_new
  good
  fair
}

// ─── MODELLER ──────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  username      String?   @unique
  email         String    @unique
  edu_email     String?   @unique
  name          String
  surname       String
  birthdate     DateTime?
  telephone     String?   @unique
  password      String?
  googleId      String?   @unique
  profile_photo String?

  account_type  AccountType @default(external)
  auth_provider AuthProvider @default(local)
  is_complete   Boolean   @default(false)
  is_verified   Boolean   @default(false)
  is_banned     Boolean   @default(false)
  is_admin      Boolean   @default(false)

  university    String?
  rating_sum    Int       @default(0)
  rating_count  Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ── İlişkiler (Prisma'nın Gücü) ──
  favorite_listings Listing[]     @relation("UserFavorites")
  saved_lists       SavedList[]   // Mongoose'daki Map yapısının SQL versiyonu
  listings          Listing[]     @relation("UserListings")

  comments_authored Comment[]     @relation("CommentAuthor")
  comments_received Comment[]     @relation("CommentTarget")

  offers_made       Offer[]       @relation("OfferApplicant")
  messages_sent     Message[]     @relation("MessageSender")

  convs_as_seller   Conversation[] @relation("ConversationSeller")
  convs_as_buyer    Conversation[] @relation("ConversationBuyer")

  activity_logs     ActivityLog[]
  ai_conversations  AIConversation[]
}

model SavedList {
  id        String   @id @default(uuid())
  name      String
  userId    String
  listingId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Aynı kullanıcı, aynı listeye, aynı ilanı iki kere ekleyemesin
  @@unique([userId, name, listingId])
}

model Listing {
  id          String        @id @default(uuid())
  ownerId     String
  owner       User          @relation("UserListings", fields: [ownerId], references: [id])

  title       String
  description String
  price       Float?
  type        ListingType
  status      ListingStatus @default(active)
  location    String


  features    Json?         // Mongoose'daki Mixed karşılığı
  criteria    Json?         // Mongoose'daki Mixed karşılığı

  photos      String[]
  views       Int           @default(0)
  save_count  Int           @default(0)
  is_deleted  Boolean       @default(false)
  expires     DateTime?

  // ── Discriminator (Alt Kategori) Alanları (Hepsi opsiyonel) ──
  condition         ItemCondition? // secondhand
  category          String?        // secondhand
  subcategory       String?        // secondhand
  smoking_allowed   String?        // roommate
  pet_friendly      String?        // roommate
  gender_preference String?        // roommate
  origin            String?        // carpooling
  destination       String?        // carpooling
  departure_date    DateTime?      // carpooling
  available_seats   Int?           // carpooling
  subject           String?        // course
  format            String?        // course
  application_url   String?        // job/scholarship
  deadline          DateTime?      // job/scholarship
  amount            Float?         // scholarship
  lecture           String?        // note

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // İlişkiler
  favorited_by  User[]         @relation("UserFavorites")
  saved_in      SavedList[]
  conversations Conversation[]
  offers        Offer[]
  comments      Comment[]
}

model Conversation {
  id          String   @id @default(uuid())
  listingId   String
  sellerId    String
  buyerId     String

  listing     Listing  @relation(fields: [listingId], references: [id])
  seller      User     @relation("ConversationSeller", fields: [sellerId], references: [id])
  buyer       User     @relation("ConversationBuyer", fields: [buyerId], references: [id])

  lastMessage Json?    // { senderId, senderName, preview, type, sentAt, isRead, emailNotified }
  unreadSeller Int     @default(0)
  unreadBuyer  Int     @default(0)

  status      String   @default("active") // active, archived, blocked
  offerStatus String   @default("No Offer")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]
  offers      Offer[]

  // Aynı ilan için aynı satıcı/alıcı arasında sadece 1 tane aktif sohbet olabilir (Mongoose'daki partial filter)
  @@index([listingId, sellerId, buyerId, status])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  offerId        String?  @unique

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  offer          Offer?       @relation(fields: [offerId], references: [id])

  type           String       @default("user") // user, system, admin
  text           String?
  photos         String[]
  location       String?

  isRead         Boolean      @default(false)
  readAt         DateTime?
  isDeleted      Boolean      @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Offer {
  id             String   @id @default(uuid())
  listingId      String
  applicantId    String
  conversationId String?

  listing        Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicant      User          @relation("OfferApplicant", fields: [applicantId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?      // Message ile 1-1 ilişki

  price          Float?
  pricePer       String        @default("One Time") // One Time, Per Month, Per Session
  note           String?
  status         String        @default("Pending") // Pending, Accepted, Rejected, Cancelled
  expiresAt      DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Comment {
  id          String   @id @default(uuid())
  listingId   String
  authorId    String
  targetId    String
  parentId    String?

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author      User     @relation("CommentAuthor", fields: [authorId], references: [id])
  target      User     @relation("CommentTarget", fields: [targetId], references: [id])

  // Self-referencing: Yorumlara verilen yanıtlar için ağaç yapısı
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")

  content     String
  rating      Int?
  is_edited   Boolean  @default(false)
  is_deleted  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── SİSTEM MODELLERİ ──────────────────────────────────────

model ActivityLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action      String
  entity_type String   @default("None")
  entity_id   String?  // Polymorphic olduğu için sadece String tutuyoruz
  metadata    Json?    // IP, mail, liste adı vb. esnek veriler için mükemmel çözüm

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([action])
}

model PendingVerification {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expires])
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String   @unique
  code      String
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expires])
}

enum AIRole {
  user
  assistant
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String?  // optional: e.g. first user message, for a "chat history" sidebar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats     AIChat[]

  @@index([userId, createdAt])
}

model AIChat {
  id               String         @id @default(uuid())
  aiConversationId String
  aiConversation   AIConversation @relation(fields: [aiConversationId], references: [id], onDelete: Cascade)

  role             AIRole
  content          Json           // full content-block array, API-shape (text/tool_use/tool_result blocks)
  stopReason       String?        // "tool_use", "end_turn", etc — useful for debugging/analytics

  createdAt        DateTime       @default(now())

  @@index([aiConversationId, createdAt])
}